# ============================================
# ImParkGameSauce - Environment Variables
# ============================================
# 이 파일을 복사하여 .env로 만들고 실제 값을 입력하세요.
#   cp .env.example .env
#
# .env  → 로컬 서버 실행용 (dotenv로 로드)
# ~/.zshrc → MCP 서버용 (export KEY=VALUE 추가)
#
# 주의: .env 파일은 절대 git에 커밋하지 마세요.
# ============================================

# --- MCP 서버용 (이 키는 ~/.zshrc에도 export 필요) ---
# NOTION_API_TOKEN=ntn_xxxxxxxxxxxx

# --- 외부 API 키 ---
# 새로운 API를 추가할 때마다 여기에 환경변수명을 추가하세요.
# STRIPE_API_KEY=
# KAKAO_REST_API_KEY=
