# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Environment variables (secrets)
# .env: 로컬 서버 실행용
# .claude/settings.local.json: MCP 서버용
.env
.env.local
.env.*.local
.claude/settings.local.json

# Harness secrets (actual key values should never be committed)
.harness/secrets/*.key
.harness/secrets/*.pem
.harness/secrets/*.json
!.harness/secrets/_keymap.json
